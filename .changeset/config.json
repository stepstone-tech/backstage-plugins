{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "privatePackages": {
    "tag": false,
    "version": false
  },
  "changedFilePatterns": [
    "**",
    "!**/*.md",
    "!docs/**",
    "!dev/**",
    "!**/*.test.{ts,tsx}",
    "!**/__fixtures__/**",
    "!**/__testutils__/**",
    "!**/__testUtils__/**"
  ]
}
