{
  "name": "@stepstone-tech/backstage-plugin-ownership-matcher-backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "ownership-matcher",
    "pluginPackages": [
      "@stepstone-tech/backstage-plugin-ownership-matcher",
      "@stepstone-tech/backstage-plugin-ownership-matcher-backend",
      "@stepstone-tech/backstage-plugin-ownership-matcher-common",
      "@stepstone-tech/backstage-plugin-ownership-matcher-node"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --runInBand --forceExit",
    "test:integration": "backstage-cli package test --runInBand --forceExit --testPathIgnorePatterns=/node_modules/ --testPathPatterns='\\.integration\\.test\\.'",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.[jt]sx?$"
    ]
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/catalog-client": "^1.16.2",
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/config": "^1.3.9",
    "@backstage/errors": "^1.3.1",
    "@backstage/integration": "^2.1.2",
    "@backstage/plugin-catalog-node": "^2.2.5",
    "@backstage/plugin-events-node": "^0.4.26",
    "@backstage/plugin-notifications-common": "^0.2.4",
    "@backstage/plugin-notifications-node": "^0.2.30",
    "@backstage/plugin-permission-common": "^0.9.11",
    "@backstage/types": "^1.2.2",
    "@stepstone-tech/backstage-plugin-ownership-matcher-node": "workspace:^",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "handlebars": "^4.7.8",
    "knex": "^3.1.0",
    "yaml": "^2.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.18.0",
    "@backstage/backend-test-utils": "^1.11.7",
    "@backstage/cli": "^0.36.6",
    "@backstage/plugin-auth-backend": "^0.30.1",
    "@backstage/plugin-auth-backend-module-guest-provider": "^0.2.23",
    "@backstage/plugin-catalog-backend": "^4.0.0",
    "@backstage/plugin-events-backend": "^0.6.6",
    "@backstage/plugin-notifications-backend": "^0.6.9",
    "@backstage/plugin-permission-backend": "^0.7.16",
    "@backstage/plugin-permission-backend-module-allow-all-policy": "^0.2.23",
    "@backstage/plugin-signals-backend": "^0.3.19",
    "@types/express": "^4.17.6",
    "@types/supertest": "^2.0.8",
    "pg": "^8.11.3",
    "supertest": "^6.2.4",
    "uuid": "^14.0.0"
  },
  "files": [
    "dist",
    "migrations/**/*.{js,d.ts}",
    "templates/**/*.hbs",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/stepstone-tech/backstage-plugins.git",
    "directory": "workspaces/ownership-matcher/plugins/ownership-matcher-backend"
  }
}
